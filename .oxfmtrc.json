{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "proseWrap": "preserve",
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    ".generated/**",
    "native/target/**",
    "native/gen/**",
    ".empryo/**",
    "public/licenses/**",
    "bun.lock",
    "native/Cargo.lock"
  ]
}
