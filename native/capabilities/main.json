{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Bundled main webview: scoped Vault, document and identity commands, invalidation events, and integrated window controls.",
  "webviews": ["main"],
  "permissions": [
    "allow-pick-document",
    "allow-open-document",
    "allow-open-link",
    "allow-check-github",
    "allow-check-jira",
    "allow-vault-open",
    "allow-vault-restore",
    "allow-vault-select-parent",
    "allow-vault-create",
    "allow-vault-refresh",
    "allow-vault-list-entries",
    "allow-vault-reconcile",
    "allow-vault-cancel-index",
    "allow-vault-close",
    "allow-vault-read-note",
    "allow-vault-create-note",
    "allow-vault-save-note",
    "allow-vault-save-copy",
    "allow-vault-adopt-note",
    "allow-vault-open-document",
    "allow-vault-select-imports",
    "allow-vault-import-files",
    "allow-vault-create-folder",
    "allow-vault-prepare-mutation",
    "allow-vault-commit-mutation",
    "allow-vault-cancel-mutation",
    "allow-vault-list-trash",
    "allow-vault-restore-trash",
    "allow-vault-purge-trash",
    "allow-vault-search",
    "allow-vault-cancel-search",
    "allow-vault-navigation-target",
    "allow-vault-recovery-list",
    "allow-vault-recover-mutation",
    "allow-vault-export-recovery",
    "allow-vault-acknowledge-recovery",
    "allow-workspace-load",
    "allow-workspace-repair-storage",
    "allow-workspace-save",
    "allow-workspace-read-tab",
    "allow-last-document-load",
    "allow-last-document-save",
    "allow-drafts-load",
    "allow-draft-save",
    "allow-draft-delete",
    "allow-preferences-load",
    "allow-preferences-save",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}
