{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adamant:schema:vault:v1",
  "title": "Adamant Vault manifest",
  "type": "object",
  "required": ["format", "formatVersion", "id"],
  "properties": {
    "format": {
      "const": "adamant-vault"
    },
    "formatVersion": {
      "const": 1
    },
    "contentRoot": {
      "const": "content"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
