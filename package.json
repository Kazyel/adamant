{
  "name": "adamant",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "app:update": "node scripts/app-update.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "fmt": "oxfmt && cargo fmt --manifest-path native/Cargo.toml",
    "fmt:check": "oxfmt --check && cargo fmt --manifest-path native/Cargo.toml --check",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:fix": "bun run lint --fix",
    "lint:rust": "cargo clippy --manifest-path native/Cargo.toml --locked --all-targets -- -D warnings",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "bun run test:ts && bun run test:rust",
    "test:ts": "node --experimental-strip-types --test \"ui/**/*.test.ts\"",
    "test:rust": "cargo test --manifest-path native/Cargo.toml --locked --lib -- --test-threads=1",
    "audit:js": "bun audit --audit-level=high --json",
    "audit:rust": "cargo audit --file native/Cargo.lock",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run lint:rust && bun run test && bun run knip",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@lezer/highlight": "1.2.3",
    "@tauri-apps/api": "2.11.1",
    "docx-preview": "0.4.0",
    "dompurify": "3.4.14",
    "marked": "18.0.11",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "knip": "6.35.1",
    "lefthook": "2.1.12",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24.14.1"
  },
  "packageManager": "bun@1.4.2"
}
