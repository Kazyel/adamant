{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Bundled main webview: scoped Vault, document and identity commands, invalidation events, and integrated window controls.",
  "webviews": ["main"],
  "permissions": [
    "allow-pick-document",
    "allow-open-document",
    "allow-check-github",
    "allow-check-jira",
    "allow-vault-open",
    "allow-vault-select-parent",
    "allow-vault-create",
    "allow-vault-refresh",
    "allow-vault-list-entries",
    "allow-vault-reconcile",
    "allow-vault-cancel-index",
    "allow-vault-close",
    "allow-vault-read-note",
    "allow-vault-create-note",
    "allow-vault-save-note",
    "allow-vault-save-copy",
    "allow-vault-adopt-note",
    "allow-vault-import-note",
    "allow-vault-open-document",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}
